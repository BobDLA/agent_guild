# Subagent Guild - .gitignore
# Project structure organized: management/, docs/, app/, config/, templates/, etc.

# Python cache files
__pycache__/
*.py[cod]
*$py.class
*.so

# Environment files
.env
.env.local
.env.production
.env.development
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Frontend environment files
frontend/.env
frontend/.env.local
frontend/.env.production
frontend/.env.development

# Database files (exclude main classification database)
*.db
*.sqlite
*.sqlite3
agent_guild.db
# Allow the main classification database
!data/db/agents.db

# Data directories (repositories are downloaded/cloned)
data/repositories/
data/temp/
# Allow db directory for classification data
!data/db/

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
*.log
logs/

# Temporary files
*.tmp
*.temp
requirements_temp.txt

# Build artifacts
build/
dist/
*.egg-info/

# Coverage reports
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover

# Pytest cache
.pytest_cache/

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Frontend / Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.node_repl_history
*.tgz

# Frontend build and cache
frontend/dist/
frontend/build/
frontend/.cache/
frontend/.temp/
frontend/.vscode/

# Frontend environment files
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# Frontend testing coverage
frontend/coverage/
frontend/.nyc_output/

# Frontend IDE and editor files
frontend/.idea/
frontend/.vscode/
frontend/*.swp
frontend*.swo

# Supabase configuration
supabase_config/
supabase_config
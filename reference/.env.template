# Subagent Guild - Environment Configuration Template
# Copy this file to .env and configure your specific values

# Database Configuration
DATABASE_URL=sqlite:///./data/db/agents.db

# Claude API Configuration
CLAUDE_API_KEY=your_claude_api_key_here

# Repository Storage
REPOSITORIES_PATH=./data/repositories

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# Application Settings
DEBUG=False
WORKERS=1

# External Service URLs (optional)
GITHUB_TOKEN=your_github_token_here

# Security Settings
SECRET_KEY=your_secret_key_here

# Deployment Environment
ENVIRONMENT=production

# Performance Settings
MAX_WORKERS=4
SYNC_INTERVAL_HOURS=24
CLASSIFICATION_BATCH_SIZE=10

# Storage Settings
MAX_DOWNLOAD_SIZE_MB=100
TEMP_DIR=./data/temp

# Rate Limiting
API_RATE_LIMIT_PER_MINUTE=60

# Monitoring
HEALTH_CHECK_TIMEOUT=30